# ================================================================
# Ampcus Cyber – Environment Variables
#
# NEVER commit your .env file to Git.
# Copy this file to .env and fill in real values.
# ================================================================

# ── Resend email service ─────────────────────────────────────
# Your Resend API key from https://resend.com/api-keys
# Must start with "re_"
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# The "from" address for outgoing invitation emails.
# This address (or its domain) must be verified in Resend.
# During testing on a free Resend account you may only send
# to your own email address UNLESS your domain is verified.
# Resend's free sandbox sender: onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# The public URL of your deployed app (no trailing slash).
# Used to generate links in emails.
# For local development: http://localhost:5173
APP_URL=https://your-project.vercel.app
